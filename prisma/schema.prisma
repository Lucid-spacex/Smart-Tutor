// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARENT
  TUTOR
  ADMIN
  STUDENT
}

enum UserStatus {
  UNVERIFIED
  ACTIVE
  PENDING_VETTING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VettingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubjectCategory {
  CORE
  ENRICHMENT
}

enum GradeBandTier {
  PRESCHOOL_TO_G1
  G2_TO_G4
  G5_TO_G8
  G9_TO_G12
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

// Structured grade level used for deterministic pricing-tier resolution.
// gradeLevel (free text on Student) is retained for display/notes purposes.
// actualGrade drives gradeBandTier mapping — see StudentsService.mapActualGradeToBand().
enum ActualGrade {
  PRESCHOOL
  KINDERGARTEN
  GRADE_1
  GRADE_2
  GRADE_3
  GRADE_4
  GRADE_5
  GRADE_6
  GRADE_7
  GRADE_8
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
}

// BREAKING CHANGE (Phase 4): Old values WEEKLY|BI_WEEKLY|MONTHLY replaced by
// actual weekly session counts. Migration maps all existing rows to TWICE_WEEKLY
// as the default (see migration SQL in prisma/migrations/).
enum SessionFrequency {
  TWICE_WEEKLY
  THRICE_WEEKLY
  FIVE_TIMES_WEEKLY
}

enum BillingFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum RecordingStatus {
  NONE
  PROCESSING
  AVAILABLE
  FAILED
}

enum PaymentProvider {
  PAYSTACK
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id           String       @id @default(uuid())
  fullName     String
  email        String?      @unique
  phone        String?
  passwordHash String
  role         UserRole
  status       UserStatus   @default(UNVERIFIED)
  studentCode  String?      @unique
  parentId     String?
  parent       User?        @relation("StudentParent", fields: [parentId], references: [id], onDelete: Cascade)
  students     User[]       @relation("StudentParent")
  timezone     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tutorProfile      TutorProfile?
  studentProfile    Student?
  enrollmentsAsTutor Enrollment[] @relation("TutorEnrollments")
  sessions          Session[]      @relation("SessionTutor")
  payments          Payment[]
  progressReports   ProgressReport[]
  refreshTokens     RefreshToken[]
  sentMessages      Message[]      @relation("MessageSender")
  receivedMessages  Message[]      @relation("MessageRecipient")
  filedComplaints   Complaint[]
  resolvedComplaints Complaint[]   @relation("ComplaintResolver")
  createdAssignments Assignment[]  @relation("AssignmentCreator")
  createdGrades     Grade[]       @relation("GradeGrader")
  approvedGrades    Grade[]       @relation("GradeApprover")
  pricingTiersUpdated PricingTier[]
  notifications     Notification[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([studentCode])
  @@index([parentId])
}

model TutorProfile {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects       String[]
  bio            String?
  credentialsUrl String?
  vettingStatus  VettingStatus @default(PENDING)
  hourlyRate     Decimal       @db.Decimal(10, 2)
  availability   Json
  createdAt      DateTime      @default(now())

  @@index([vettingStatus])
}

model Student {
  id                 String        @id @default(uuid())
  parentId           String
  userId             String        @unique
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  dateOfBirth        DateTime
  // Structured enum — drives gradeBandTier resolution deterministically.
  // When present, takes precedence over the legacy gradeLevel regex mapping.
  actualGrade        ActualGrade?
  // Free-text display field (e.g. "Springfield Elementary, Grade 5 repeated").
  // Retained alongside actualGrade for supplementary notes — NOT deprecated.
  gradeLevel         String
  // Auto-derived from actualGrade (preferred) or gradeLevel (legacy fallback).
  // Admin can manually correct if the auto-mapping is wrong.
  gradeBandTier      GradeBandTier @default(G5_TO_G8)
  gender             Gender?
  // Contact/notification email for the student (e.g. CC on notifications).
  // IMPORTANT: This is metadata ONLY. It is NOT a login credential.
  // Login remains strictly: parent email + student code + student password.
  email              String?
  // Parent's intended start date, captured at profile creation before
  // a specific enrollment/subject/tutor is finalised.
  preferredStartDate DateTime?
  school             String?
  notes              String?
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())

  enrollments        Enrollment[]
  quizAttempts       QuizAttempt[]

  @@index([parentId])
  @@index([userId])
  @@index([deletedAt])
  @@index([gradeBandTier])
  @@index([actualGrade])
}

model Subject {
  id         String          @id @default(uuid())
  name       String          @unique
  gradeBand  String
  category   SubjectCategory
  createdAt  DateTime        @default(now())

  enrollments Enrollment[]

  @@index([category])
}

model Enrollment {
  id                String           @id @default(uuid())
  // Shared across all subjects enrolled in one sitting.
  // null for single-subject enrollments created outside a batch.
  enrollmentGroupId String?          @db.Uuid
  studentId         String
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           Subject          @relation(fields: [subjectId], references: [id])
  tutorId           String?
  tutor             User?            @relation("TutorEnrollments", fields: [tutorId], references: [id])
  sessionFrequency  SessionFrequency
  // Days the parent is available, subset of MON|TUE|WED|THU|FRI|SAT|SUN.
  // Count must match sessionFrequency: 2 for TWICE_WEEKLY, 3 for THRICE_WEEKLY,
  // 5 for FIVE_TIMES_WEEKLY. Validated at the service layer.
  availableDays     String[]
  // Preferred session window in parent's OWN local timezone (stored as raw hours).
  // DO NOT store a pre-converted "Nigeria time" copy — convert on demand using
  // the parent's User.timezone to avoid stale values across DST changes.
  preferredStartHour Int?
  preferredEndHour   Int?
  billingFrequency BillingFrequency @default(YEARLY)
  yearlyPrice       Decimal?         @db.Decimal(10, 2) // Legacy field, made optional
  yearlyPriceNGN    Decimal?         @db.Decimal(10, 2) // Override price in NGN
  yearlyPriceUSD    Decimal?         @db.Decimal(10, 2) // Override price in USD
  status            EnrollmentStatus @default(ACTIVE)
  startDate         DateTime
  endDate           DateTime?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())

  sessionParticipants SessionParticipant[]
  payments           Payment[]
  progressReports    ProgressReport[]
  assignments        Assignment[]
  grades             Grade[]

  @@index([studentId])
  @@index([subjectId])
  @@index([tutorId])
  @@index([status])
  @@index([deletedAt])
  @@index([enrollmentGroupId])
}

model Session {
  id              String       @id @default(uuid())
  tutorId         String
  tutor           User         @relation("SessionTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  durationMinutes Int
  zoomLink        String?
  zoomMeetingId   String?
  recordingUrl    String?
  recordingStatus RecordingStatus @default(NONE)
  status          SessionStatus @default(SCHEDULED)
  tutorNotes      String?
  homeworkAssigned String?
  createdAt       DateTime     @default(now())

  participants SessionParticipant[]

  @@index([tutorId])
  @@index([scheduledAt])
  @@index([status])
  @@index([zoomMeetingId])
}

model SessionParticipant {
  id           String    @id @default(uuid())
  sessionId    String
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  attended     Boolean?
  createdAt    DateTime  @default(now())

  @@index([sessionId])
  @@index([enrollmentId])
}

model Payment {
  id               String        @id @default(uuid())
  parentId         String
  parent           User          @relation(fields: [parentId], references: [id], onDelete: Cascade)
  // Populated for single-enrollment payments. null for group payments.
  enrollmentId     String?
  enrollment       Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  // Populated for multi-subject batch payments. null for single-enrollment payments.
  // Exactly one of enrollmentId / enrollmentGroupId is non-null on any given row.
  enrollmentGroupId String?      @db.Uuid
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("USD")
  provider         PaymentProvider
  providerReference String?
  status           PaymentStatus @default(PENDING)
  paidAt           DateTime?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())

  @@index([parentId])
  @@index([enrollmentId])
  @@index([enrollmentGroupId])
  @@index([status])
  @@index([provider])
  @@index([deletedAt])
}

model ProgressReport {
  id             String   @id @default(uuid())
  enrollmentId   String
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  period         String
  summary        String
  strengths      String
  areasToImprove String
  createdBy      String
  creator        User     @relation(fields: [createdBy], references: [id])
  createdAt      DateTime @default(now())

  @@index([enrollmentId])
  @@index([createdBy])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient  User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  threadId   String
  body       String
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@index([threadId])
}

model Assignment {
  id           String        @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdBy    String
  creator      User         @relation("AssignmentCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  title        String
  description  String
  type         AssignmentType
  dueDate      DateTime
  status       AssignmentStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  grades Grade[]
  quizQuestions QuizQuestion[]
  quizAttempts QuizAttempt[]

  @@index([enrollmentId])
  @@index([createdBy])
  @@index([dueDate])
  @@index([status])
}

enum AssignmentType {
  ASSIGNMENT
  CLASSWORK
  TEST
}

enum AssignmentStatus {
  PENDING
  COMPLETED
}

model Grade {
  id           String       @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   Assignment?  @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  gradedBy     String
  grader       User         @relation("GradeGrader", fields: [gradedBy], references: [id], onDelete: Cascade)
  score        Decimal      @db.Decimal(10, 2)
  comments     String
  status       GradeStatus  @default(PENDING_APPROVAL)
  approvedBy   String?
  approver     User?        @relation("GradeApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  visibleToStudent Boolean @default(false)
  createdAt    DateTime     @default(now())

  @@index([enrollmentId])
  @@index([assignmentId])
  @@index([gradedBy])
  @@index([status])
  @@index([visibleToStudent])
}

enum GradeStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  relatedId String?
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([type])
  @@index([isRead])
}

enum NotificationType {
  ASSIGNMENT_DUE_SOON
  ASSIGNMENT_OVERDUE
  GRADE_APPROVED
  COMPLAINT_RESOLVED
  GENERAL
  PRICING_DRIFT_ALERT
}

model Complaint {
  id          String       @id @default(uuid())
  filedBy     String
  filer       User         @relation(fields: [filedBy], references: [id], onDelete: Cascade)
  aboutType   ComplaintAboutType
  aboutId     String?
  subject     String
  description String
  status      ComplaintStatus @default(OPEN)
  adminReply  String?
  resolvedBy  String?
  resolver    User?        @relation("ComplaintResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([filedBy])
  @@index([status])
}

enum ComplaintAboutType {
  STUDENT
  TUTOR
  PARENT
  GENERAL
}

enum ComplaintStatus {
  OPEN
  RESOLVED
}

model RefreshToken {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  tokenFamily  String   // Track token family for rotation detection (not unique - multiple tokens can share a family)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  revokedAt    DateTime? // Set when token is revoked due to reuse detection

  @@index([userId])
  @@index([tokenHash])
  @@index([tokenFamily])
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  otpHash   String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([otpHash])
  @@index([expiresAt])
}

model PricingTier {
  id              String       @id @default(uuid())
  gradeBandTier   GradeBandTier @unique
  yearlyPriceNGN  Decimal      @db.Decimal(10, 2)
  yearlyPriceUSD  Decimal      @db.Decimal(10, 2)
  updatedAt       DateTime     @updatedAt
  updatedBy       String
  updater         User         @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([gradeBandTier])
}

model ExchangeRate {
  id         String   @id @default(uuid())
  fromCurrency String
  toCurrency String
  rate       Decimal  @db.Decimal(10, 6)
  fetchedAt  DateTime @default(now())

  @@unique([fromCurrency, toCurrency])
  @@index([fromCurrency])
  @@index([toCurrency])
}

model QuizQuestion {
  id                String   @id @default(uuid())
  assignmentId      String
  assignment        Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionText      String
  options           Json     // Array of strings
  correctOptionIndex Int
  points            Decimal  @db.Decimal(10, 2)
  orderIndex        Int
  createdAt         DateTime @default(now())

  responses QuizResponse[]

  @@index([assignmentId])
}

model QuizAttempt {
  id          String          @id @default(uuid())
  assignmentId String
  assignment  Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      QuizAttemptStatus @default(IN_PROGRESS)
  totalScore  Decimal?        @db.Decimal(10, 2)
  startedAt   DateTime        @default(now())
  completedAt DateTime?

  responses QuizResponse[]

  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
}

model QuizResponse {
  id                  String   @id @default(uuid())
  attemptId           String
  attempt             QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId          String
  question            QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIndex Int
  isCorrect           Boolean
  timeTakenSeconds    Int
  pointsAwarded       Decimal  @db.Decimal(10, 2)
  createdAt           DateTime @default(now())

  @@index([attemptId])
  @@index([questionId])
}

enum QuizAttemptStatus {
  IN_PROGRESS
  COMPLETED
}
