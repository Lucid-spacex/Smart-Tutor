# Database
DATABASE_URL="postgresql://username:password@localhost:5432/smart_tutor?schema=public&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://username:password@localhost:5432/smart_tutor?schema=public"

# JWT
JWT_ACCESS_SECRET="super-secret-access-token-key-must-be-at-least-32-chars"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-must-be-at-least-32-chars"
JWT_ACCESS_EXPIRY="1d" # Access token lifetime (default 1 day). Longer lifetime compensated by session-based revocation.
JWT_REFRESH_EXPIRY="7d"

# Paystack
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
PAYSTACK_PUBLIC_KEY="your-paystack-public-key"

# Frontend
FRONTEND_URL="http://localhost:3001"

# Server
PORT=3000
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
# For production: ALLOWED_ORIGINS="https://teachmenest.com,http://localhost:3000"

# Email (Resend API)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="Teachmenest <no-reply@teachmenest.com>"
EMAIL_REPLY_TO="support@teachmenest.com"

# Exchange Rate API (for pricing drift monitoring)
EXCHANGERATE_API_KEY="your-exchangerate-api-key"
PRICING_DRIFT_THRESHOLD_PERCENT="7"

# Google Calendar (for meeting management)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_ORGANIZER_EMAIL="organizer@yourdomain.com"
GOOGLE_CALENDAR_ID="primary"

# Cloudinary (for file storage - profile pictures, attachments)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"




